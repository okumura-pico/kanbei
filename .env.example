# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real secrets.

# Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=

# GitHub App credentials (see docs/03-setup.md once written)
KANBEI_APP_ID=
KANBEI_APP_INSTALLATION_ID=

# PEM private key. Either a path:
KANBEI_APP_PRIVATE_KEY_PATH=
# ...or the inline PEM (multi-line via dotenv supports `"..."` with \n).
# KANBEI_APP_PRIVATE_KEY=

# Optional: default repo Kanbei operates on (owner/repo).
# When omitted, CLI requires --repo.
KANBEI_REPO=
