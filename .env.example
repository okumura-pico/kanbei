# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real secrets.
# See docs/03-setup.md for the full setup walkthrough.

# Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=

# GitHub App credentials
KANBEI_APP_ID=
KANBEI_APP_INSTALLATION_ID=

# Private key — choose ONE of the two options below:
#
# Option A (recommended): path to the .pem file on disk.
# The file itself is gitignored via *.pem.
KANBEI_APP_PRIVATE_KEY_PATH=
#
# Option B: inline PEM. Use a quoted string with \n line separators.
# KANBEI_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Kill switch: set to "true" to halt all orchestrator activity without
# changing code. Useful for pausing autonomous runs.
# KANBEI_DISABLED=false
